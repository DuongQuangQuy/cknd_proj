<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Cron Job: Refresh Materialized View mỗi 5 phút -->
        <record id="ir_cron_refresh_search_cache" model="ir.cron">
            <field name="name">Refresh Real Estate Search Cache</field>
            <field name="model_id" ref="model_real_estate_search"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_materialized_view()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>
        
        <!-- Cron Job: Cleanup expired cache mỗi 1 giờ -->
        <record id="ir_cron_cleanup_search_cache" model="ir.cron">
            <field name="name">Cleanup Expired Search Cache</field>
            <field name="model_id" ref="model_real_estate_search"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_expired_cache()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>
        
    </data>
</odoo>
