<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit real_estate_search form view để thêm pagination -->
        <record id="real_estate_search_view_form_pagination" model="ir.ui.view">
            <field name="name">real.estate.search.view.form.pagination</field>
            <field name="model">real.estate.search</field>
            <field name="inherit_id" ref="real_estate_search_view_form"/>
            <field name="arch" type="xml">
                
                <!-- Đặt pagination vào góc phải của o_x2m_control_panel (nơi pager đã ẩn) -->
                <xpath expr="//field[@name='real_estate_ids']" position="before">
                    <div style="display:flex; justify-content:flex-end; align-items:center; margin-bottom:4px; gap:10px; padding-right:4px;">
                        <field name="page_size" style="width:auto;"/>
                        <div style="display:flex; align-items:center; gap:4px;">
                            <button name="action_first_page"
                                    string="⏮"
                                    type="object"
                                    class="btn-sm btn-secondary"
                                    attrs="{'invisible': [('page', '=', 1)]}"/>
                            <button name="action_prev_page"
                                    string="◀"
                                    type="object"
                                    class="btn-sm btn-primary"
                                    attrs="{'invisible': [('page', '=', 1)]}"/>
                            <span style="margin:0 4px; font-weight:bold;">
                                <field name="page" style="width:36px; text-align:center; display:inline-block;"/>
                                <span style="margin:0 3px;">/</span>
                                <field name="total_pages" readonly="1" style="display:inline-block; color:#6c757d;"/>
                            </span>
                            <button name="action_next_page"
                                    string="▶"
                                    type="object"
                                    class="btn-sm btn-primary"/>
                            <button name="action_last_page"
                                    string="⏭"
                                    type="object"
                                    class="btn-sm btn-secondary"/>
                            <span style="margin-left:8px; color:#007bff; font-size:12px;">
                                (<field name="total_count" readonly="1" style="display:inline-block; color:#007bff; font-weight:bold;"/> kết quả)
                            </span>
                        </div>
                    </div>
                </xpath>
                
            </field>
        </record>
        
    </data>
</odoo>
